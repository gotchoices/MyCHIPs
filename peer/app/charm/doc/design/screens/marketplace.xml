<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="../components/transforms/master.xsl"?>
<app-screen width="375" height="812" xmlns="http://mychips.io/ui">
    
    <app-header data-title="Marketplace"/>
    
    <!-- Search and filter -->
    <search-bar 
        data-placeholder="Search vendors..."
        x="20" y="120"/>
    
    <filter-chips x="20" y="170">
        <filter-chip data-label="All" data-active="true" x="0" y="0"/>
        <filter-chip data-label="Food" data-active="false" x="50" y="0"/>
        <filter-chip data-label="Services" data-active="false" x="100" y="0"/>
        <filter-chip data-label="Retail" data-active="false" x="170" y="0"/>
    </filter-chips>
    
    <!-- Info banner -->
    <info-banner 
        data-message="These vendors accept CHIPs or can form tallies with customers"
        data-type="info"
        x="20" y="220"/>
    
    <!-- Vendor list -->
    <vendor-list x="20" y="280">
        <vendor-item 
            data-name="Coffee Corner"
            data-category="Food &amp; Beverage"
            data-description="Local coffee shop accepting CHIPs"
            data-rating="4.8"
            data-distance="0.3 mi"
            data-accepts-chips="true"
            data-accepts-tallies="true"
            data-logo="☕"
            x="0" y="0"/>
            
        <vendor-item 
            data-name="Green Market"
            data-category="Groceries"
            data-description="Fresh produce, accepts CHIPs for regular customers"
            data-rating="4.6"
            data-distance="0.7 mi"
            data-accepts-chips="false"
            data-accepts-tallies="true"
            data-logo="🥬"
            x="0" y="100"/>
            
        <vendor-item 
            data-name="Tech Repair Shop"
            data-category="Services"
            data-description="Phone and laptop repair, tally partnerships available"
            data-rating="4.9"
            data-distance="1.2 mi"
            data-accepts-chips="true"
            data-accepts-tallies="true"
            data-logo="🔧"
            x="0" y="200"/>
    </vendor-list>
    
    <!-- Action button -->
    <button-secondary 
        data-label="Visit mychips.org for more vendors"
        x="20" y="640" 
        width="335" 
        height="44"/>
    
    <!-- Bottom navigation -->
    <bottom-tab-bar x="0" y="729">
        <tab-item data-label="Home" data-icon="🏠" data-active="false" data-icon-color="#8E8E93" data-text-color="#8E8E93" data-font-weight="500" x="37.5" y="10"/>
        <tab-item data-label="Invoice" data-icon="📄" data-active="false" data-icon-color="#8E8E93" data-text-color="#8E8E93" data-font-weight="500" x="112.5" y="10"/>
        <tab-item data-label="Scan" data-icon="📷" data-active="false" data-icon-color="#8E8E93" data-text-color="#8E8E93" data-font-weight="500" x="187.5" y="10"/>
        <tab-item data-label="Tally" data-icon="🤝" data-active="true" data-icon-color="#007AFF" data-text-color="#007AFF" data-font-weight="600" x="262.5" y="10"/>
        <tab-item data-label="Settings" data-icon="⚙️" data-active="false" data-icon-color="#8E8E93" data-text-color="#8E8E93" data-font-weight="500" x="337.5" y="10"/>
    </bottom-tab-bar>
    
</app-screen>
